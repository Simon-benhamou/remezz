{
  "$schema": "vscode://schemas/tasks",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Vite dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^",
          "endsPattern": "Local:\\shttp://.*:5173"
        }
      }
    },
    {
      "label": "Frontend: Stop Vite",
      "command": "bash",
      "args": ["-lc", "pkill -f 'vite --host' || true"],
      "problemMatcher": []
    },
    {
      "label": "Backend: dev:debug",
      "type": "npm",
      "script": "dev:debug",
      "path": "backend",
      "group": "build"
    }
  ]
}

