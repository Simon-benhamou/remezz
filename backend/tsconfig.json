{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": [
    "src",
    "scripts"
  ],
  "exclude": [
    "scripts/analyze-*.ts",
    "scripts/compare-*.ts",
    "scripts/concrete-*.ts",
    "scripts/test-consecutive-*.ts",
    "scripts/test-early-*.ts",
    "scripts/test-nfs-*.ts",
    "scripts/temp-*.ts",
    "scripts/deep-*.ts",
    "scripts/check-*.ts"
  ]
}