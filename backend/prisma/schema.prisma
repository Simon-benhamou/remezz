generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User authentication model
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("trader") // 'admin', 'trader', 'viewer'
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  // API Keys and settings
  apiKeys      UserApiKey[]
  settings     UserSetting[]

  // User's trading sessions and activities
  sessions     AgentSession[]
  alerts       Alert[]
  reports      DailyReport[]
  improvements ImprovementItem[]
  diagnosticsCache DiagnosticsCache[]

  @@index([username])
  @@index([email])
}

// User API Keys for exchanges
model UserApiKey {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  exchange  String   // 'crypto.com', 'binance', 'coinbase', etc.
  keyName   String?  // optional alias for the key
  apiKey    String   // encrypted
  apiSecret String   // encrypted
  passphrase String? // encrypted (for some exchanges)
  testnet   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exchange, testnet])
  @@index([userId])
}

// User Settings
model UserSetting {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  key      String
  value    String
  category String @default("general") // 'trading', 'ui', 'notifications', etc.

  @@unique([userId, key])
  @@index([userId, category])
}

model AgentSession {
  id              String   @id @default(cuid())
  user            User?    @relation(fields: [userId], references: [id])
  userId          String?
  symbol          String
  mode            String   // 'paper' | 'live'
  startedAt       DateTime @default(now())
  stoppedAt       DateTime?
  startBalanceUsd Float?
  profileJson     Json?
  planJson        Json?

  // Smart Auto Mode fields
  isSmartAgent         Boolean @default(false)
  smartConfig          Json?   // Configuration for smart mode
  currentSymbol        String? // Current active symbol (can differ from original symbol)
  lastSymbolSwitchAt   DateTime?
  nextRescanAt         DateTime?
  smartHistory         Json?   // History of symbol switches and reasons

  strategies Strategy[]
  orders     Order[]
  fills      Fill[]                // back-rel from Fill.session
  positions  Position[]
  kpi        SessionKpi?
  triggers   TriggerLog[]
  sentiments SentimentSnapshot[]   // back-rel from SentimentSnapshot.session
  alerts     Alert[]               // back-rel from Alert.session
  reports    DailyReport[]         // back-rel from DailyReport.session
  prompts    AiPromptLog[]

  @@index([userId, stoppedAt, startedAt])
  @@index([stoppedAt, startedAt])
  @@index([isSmartAgent, nextRescanAt])
}

model Strategy {
  id           String   @id
  session      AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId    String?
  symbol       String
  bias         String
  confidence   Float?
  entryJson    Json
  riskJson     Json
  validityFrom DateTime?
  validityTo   DateTime?
  rationale    String?
  rawPrompt    String?
  rawResponse  Json?
  trigger      String
  createdAt    DateTime @default(now())

  // ⇐ back-rel manquant pour Order.strategy
  // back-rel for Order.strategy
  orders       Order[]

  @@index([sessionId])
  @@index([symbol, createdAt])
}

model Order {
  id              String   @id @default(cuid())
  clientOrderId   String   @unique
  exchangeOrderId String?
  session         AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId       String?
  strategy        Strategy? @relation(fields: [strategyId], references: [id])
  strategyId      String?
  symbol          String
  side            String
  type            String
  tif             String?
  qty             Float
  requestedQty    Float?
  price           Float?
  requestedPrice  Float?
  sl              Float?
  tp              Float?
  leverage        Float?
  pctChange       Float?
  latencyMs       Int?
  slippageBps     Float?
  fillRatio       Float?
  cancelCount     Int?     @default(0)
  attempts        Int?
  source          String   @default("agent")
  status          String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fills           Fill[]

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
}

model Fill {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id])
  orderId      String
  tradeId      String?
  price        Float
  qty          Float
  fee          Float?
  side         String
  realizedPnl  Float?
  ts           DateTime @default(now())

  // Support AgentSession.fills relation
  session      AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId    String?

  @@index([sessionId])
  @@index([orderId])
}

model Position {
  id            String   @id @default(cuid())
  session       AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId     String?
  symbol        String
  side          String
  entryPrice    Float?
  qty           Float?
  markPrice     Float?
  unrealizedPnl Float?
  leverage      Float?
  openedAt      DateTime? @default(now())
  updatedAt     DateTime  @updatedAt
  stopPrice     Float?
  takeProfit    Json?
  slOrderId     String?
  tpOrderId     String?
  lastProtectiveSyncAt DateTime?
  protectiveStatus     String?

  @@index([sessionId])
}

model SessionKpi {
  session          AgentSession @relation(fields: [sessionId], references: [id])
  sessionId        String @id
  realizedPnlUsd   Float  @default(0)
  unrealizedPnlUsd Float  @default(0)
  roiPct           Float  @default(0)
  winRate          Float  @default(0)
  expectancy       Float  @default(0)
  maxDrawdownPct   Float  @default(0)
  avgHoldingMin    Float  @default(0)
  lastUpdated      DateTime @default(now())
  stats            Json?

  // AI usage metrics (persisted so they survive restarts)
  aiCallsTotal     Int    @default(0)
  aiInputTokens    Int    @default(0)
  aiOutputTokens   Int    @default(0)
  aiCostUsd        Float  @default(0)
  aiByModel        Json?
}

model SentimentSnapshot {
  id             String   @id @default(cuid())
  session        AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId      String?
  ts             DateTime @default(now())
  fearGreed      Int?
  twitterBullish Float?
  newsScore      Float?
  summary        String?

  @@index([sessionId])
}

model TriggerLog {
  id        String   @id @default(cuid())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  symbol    String
  kind      String   // support-touch | resistance-touch | sudden-move | volume-spike | news-spike
  payload   Json
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model Alert {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  symbol    String?
  kind      String   // late_invalidation_exit | missed_partial | overtrading | ...
  severity  String   // low | med | high
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model DailyReport {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  day       String   // YYYY-MM-DD
  stats     Json?
  llm       Json?
  createdAt DateTime @default(now())

  @@unique([sessionId, day])
  @@index([userId, day])
  @@index([sessionId, day])
}

model AiPromptLog {
  id        String   @id @default(cuid())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  symbol    String?
  kind      String?
  provider  String
  model     String?
  prompt    String
  response  Json?
  cached    Boolean  @default(false)
  tokensIn  Int?
  tokensOut Int?
  costUsd   Float?
  error     String?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model ImprovementItem {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  title       String
  description String
  severity    String   @default("medium")
  status      String   @default("open")
  context     Json?
  tags        String[]
  reporter    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([severity])
}

model DiagnosticsCache {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  symbol    String
  data      Json
  createdAt DateTime @default(now())

  @@index([userId, symbol, createdAt])
  @@index([userId, createdAt])
}

model DecisionMemory {
  id             String   @id @default(cuid())
  sessionId      String?
  symbol         String
  family         String
  timeframe      String   @default("15m")
  bias           String?
  score          Float?
  confidence     Float?
  biasConfidence Float?
  features       Json
  outcome        String?
  realizedPnl    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([symbol, createdAt])
  @@index([family, createdAt])
  @@index([sessionId, createdAt])
}

model AdaptiveThreshold {
  id               String   @id @default(cuid())
  family           String   @unique
  momentumWeight   Float    @default(1)
  volumeWeight     Float    @default(1)
  volatilityWeight Float    @default(1)
  confidence       Float    @default(0)
  sampleSize       Int      @default(0)
  lastWinRate      Float    @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model LeverageConstraint {
  id                 String   @id @default(cuid())
  symbol             String
  category           String?
  targetLeverage     Float?
  hardCap            Float?
  liquidityUsd       Float?
  liquiditySampledAt DateTime?
  atrPct             Float?
  atrSampledAt       DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([symbol, category])
  @@index([symbol])
  @@index([category])
}
