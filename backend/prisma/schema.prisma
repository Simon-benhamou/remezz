generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentSession {
  id              String   @id @default(cuid())
  symbol          String
  mode            String   // 'paper' | 'live'
  startedAt       DateTime @default(now())
  stoppedAt       DateTime?
  startBalanceUsd Float?
  profileJson     Json?
  planJson        Json?

  strategies Strategy[]
  orders     Order[]
  fills      Fill[]                // back-rel from Fill.session
  positions  Position[]
  kpi        SessionKpi?
  triggers   TriggerLog[]
  sentiments SentimentSnapshot[]   // back-rel from SentimentSnapshot.session
  alerts     Alert[]               // back-rel from Alert.session
  reports    DailyReport[]         // back-rel from DailyReport.session

  @@index([stoppedAt, startedAt])
}

model Strategy {
  id           String   @id
  session      AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId    String?
  symbol       String
  bias         String
  confidence   Float?
  entryJson    Json
  riskJson     Json
  validityFrom DateTime?
  validityTo   DateTime?
  rationale    String?
  rawPrompt    String?
  rawResponse  Json?
  trigger      String
  createdAt    DateTime @default(now())

  // ⇐ back-rel manquant pour Order.strategy
  // back-rel for Order.strategy
  orders       Order[]

  @@index([sessionId])
  @@index([symbol, createdAt])
}

model Order {
  id              String   @id @default(cuid())
  clientOrderId   String   @unique
  exchangeOrderId String?
  session         AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId       String?
  strategy        Strategy? @relation(fields: [strategyId], references: [id])
  strategyId      String?
  symbol          String
  side            String
  type            String
  tif             String?
  qty             Float
  price           Float?
  sl              Float?
  tp              Float?
  leverage        Float?
  pctChange       Float?
  source          String   @default("agent")
  status          String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fills           Fill[]

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
}

model Fill {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id])
  orderId      String
  tradeId      String?
  price        Float
  qty          Float
  fee          Float?
  side         String
  realizedPnl  Float?
  ts           DateTime @default(now())

  // Support AgentSession.fills relation
  session      AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId    String?

  @@index([sessionId])
  @@index([orderId])
}

model Position {
  id            String   @id @default(cuid())
  session       AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId     String?
  symbol        String
  side          String
  entryPrice    Float?
  qty           Float?
  markPrice     Float?
  unrealizedPnl Float?
  leverage      Float?
  openedAt      DateTime? @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sessionId])
}

model SessionKpi {
  session          AgentSession @relation(fields: [sessionId], references: [id])
  sessionId        String @id
  realizedPnlUsd   Float  @default(0)
  unrealizedPnlUsd Float  @default(0)
  roiPct           Float  @default(0)
  winRate          Float  @default(0)
  expectancy       Float  @default(0)
  maxDrawdownPct   Float  @default(0)
  avgHoldingMin    Float  @default(0)
  lastUpdated      DateTime @default(now())

  // AI usage metrics (persisted so they survive restarts)
  aiCallsTotal     Int    @default(0)
  aiInputTokens    Int    @default(0)
  aiOutputTokens   Int    @default(0)
  aiCostUsd        Float  @default(0)
  aiByModel        Json?
}

model SentimentSnapshot {
  id             String   @id @default(cuid())
  session        AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId      String?
  ts             DateTime @default(now())
  fearGreed      Int?
  twitterBullish Float?
  newsScore      Float?
  summary        String?

  @@index([sessionId])
}

model TriggerLog {
  id        String   @id @default(cuid())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  symbol    String
  kind      String   // support-touch | resistance-touch | sudden-move | volume-spike | news-spike
  payload   Json
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model Alert {
  id        String   @id @default(cuid())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  symbol    String?
  kind      String   // late_invalidation_exit | missed_partial | overtrading | ...
  severity  String   // low | med | high
  details   Json?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model DailyReport {
  id        String   @id @default(cuid())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  sessionId String?
  day       String   // YYYY-MM-DD
  stats     Json?
  llm       Json?
  createdAt DateTime @default(now())

  @@unique([sessionId, day])
  @@index([sessionId, day])
}
