generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                  @id @default(cuid())
  username         String                  @unique
  email            String                  @unique
  passwordHash     String
  role             String                  @default("trader")
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  lastLoginAt      DateTime?
  isLegacy         Boolean                 @default(false)
  sessions         AgentSession[]
  alerts           Alert[]
  auditLogs        AuditLog[]
  reports          DailyReport[]
  diagnosticsCache DiagnosticsCache[]
  improvements     ImprovementItem[]
  learningStates   SubagentLearningState[]
  tradeEvaluations TradeEvaluation[]
  apiKeys          UserApiKey[]
  settings         UserSetting[]

  @@index([username])
  @@index([email])
}

model UserApiKey {
  id         String   @id @default(cuid())
  userId     String
  exchange   String
  keyName    String?
  apiKey     String
  apiSecret  String
  passphrase String?
  testnet    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, testnet])
  @@index([userId])
}

model UserSetting {
  id       String @id @default(cuid())
  userId   String
  key      String
  value    String
  category String @default("general")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, category])
}

model AgentSession {
  id                 String                   @id @default(cuid())
  userId             String?
  needsAttention     Boolean                  @default(false)
  symbol             String
  mode               String
  startedAt          DateTime                 @default(now())
  stoppedAt          DateTime?
  haltedAt           DateTime?
  haltReason         String?
  startBalanceUsd    Float?
  profileJson        Json?
  planJson           Json?
  rrFloor            Float                    @default(1.0)
  rrCeil             Float                    @default(2.0)
  rrBaseMin          Float                    @default(1.3)
  rrExpectancy       Json?                    @default("{}")
  isSmartAgent       Boolean                  @default(false)
  smartConfig        Json?
  currentSymbol      String?
  lastSymbolSwitchAt DateTime?
  nextRescanAt       DateTime?
  smartHistory       Json?
  actionIntents      AgentActionIntent[]
  opsTelemetry       AgentOpsTelemetry?
  performanceLedger  AgentPerformanceLedger[]
  user               User?                    @relation(fields: [userId], references: [id])
  alerts             Alert[]
  reports            DailyReport[]
  fills              Fill[]
  orders             Order[]
  pendingIntents     PendingIntent[]
  positions          Position[]
  SessionKpi         SessionKpi?              @relation("AgentSessionToSessionKpi")
  strategies         Strategy[]
  trades             Trade[]
  triggers           TriggerLog[]

  @@index([userId, stoppedAt, startedAt])
  @@index([stoppedAt, startedAt])
  @@index([isSmartAgent, nextRescanAt])
}

model AgentActionIntent {
  id            String            @id
  sessionId     String
  symbol        String
  type          String
  priority      String
  confidence    Float
  reason        String
  payload       Json?
  status        AgentActionStatus @default(pending)
  result        Json?
  failureReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  startedAt     DateTime?
  executedAt    DateTime?
  session       AgentSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sessionId, status])
}

model PendingIntent {
  id                String       @id @default(cuid())
  sessionId         String
  symbol            String
  action            String
  targetOffset      Float?
  originalPrice     Float
  originalSignal    Json
  expiresAt         DateTime
  confirmationTicks Int          @default(0)
  status            String       @default("active")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  executedAt        DateTime?
  session           AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, status], name: "one_active_per_session")
  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model SchedulerJob {
  id        String    @id @default(cuid())
  type      String
  payload   Json?
  runAt     DateTime
  status    String    @default("pending")
  lockedBy  String?
  lockedAt  DateTime?
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([type, runAt])
  @@index([type, status, runAt])
  @@index([status, runAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String
  userId    String?
  username  String?
  details   Json?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

model Strategy {
  id           String        @id
  sessionId    String?
  symbol       String
  bias         String
  confidence   Float?
  entryJson    Json
  riskJson     Json
  validityFrom DateTime?
  validityTo   DateTime?
  rationale    String?
  rawPrompt    String?
  rawResponse  Json?
  trigger      String
  createdAt    DateTime      @default(now())
  orders       Order[]
  session      AgentSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([symbol, createdAt])
}

model Order {
  id                 String        @id @default(cuid())
  clientOrderId      String        @unique
  exchangeOrderId    String?
  sessionId          String?
  strategyId         String?
  symbol             String
  side               String
  type               String
  tif                String?
  qty                Float
  requestedQty       Float?
  price              Float?
  requestedPrice     Float?
  sl                 Float?
  tp                 Float?
  leverage           Float?
  pctChange          Float?
  latencyMs          Int?
  slippageBps        Float?
  fillRatio          Float?
  cancelCount        Int?          @default(0)
  attempts           Int?
  source             String        @default("agent")
  status             String?
  error              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  strategyUsed       String?
  strategyConfidence Float?
  fills              Fill[]
  session            AgentSession? @relation(fields: [sessionId], references: [id])
  strategy           Strategy?     @relation(fields: [strategyId], references: [id])

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
  @@index([strategyUsed, status])
}

model Fill {
  id             String        @id @default(cuid())
  orderId        String
  tradeId        String?
  price          Float
  qty            Float
  fee            Float?
  side           String
  realizedPnl    Float?
  ts             DateTime      @default(now())
  sessionId      String?
  strategyUsed   String?
  symbol         String?
  strategyFamily String?
  strategyId     String?
  entryTs        DateTime?
  exitReason     String?
  maxPnlPct      Float?
  order          Order         @relation(fields: [orderId], references: [id])
  session        AgentSession? @relation(fields: [sessionId], references: [id])
  trade          Trade?        @relation(fields: [tradeId], references: [id])

  @@index([sessionId])
  @@index([orderId])
  @@index([symbol, ts])
  @@index([strategyUsed])
  @@index([strategyFamily, strategyId])
  @@index([tradeId])
}

model Trade {
  id              String       @id @default(cuid())
  sessionId       String
  symbol          String
  positionSide    String
  qty             Float
  entryPrice      Float
  exitPrice       Float
  entryNotional   Float
  realizedPnlUsd  Float
  feesUsd         Float
  pctChange       Float?
  roiPct          Float?
  leverage        Float?
  roePct          Float?
  orderCount      Int          @default(0)
  exitReason      String?
  durationMinutes Int?
  maxPnlPct       Float?
  entryTs         DateTime
  exitTs          DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  fills           Fill[]
  session         AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, exitTs])
  @@index([symbol, exitTs])
  @@index([exitTs])
}

model Position {
  id                   String        @id @default(cuid())
  sessionId            String?
  symbol               String
  side                 String
  entryPrice           Float?
  qty                  Float?
  markPrice            Float?
  unrealizedPnl        Float?
  leverage             Float?
  openedAt             DateTime?     @default(now())
  updatedAt            DateTime      @updatedAt
  stopPrice            Float?
  takeProfit           Json?
  slOrderId            String?
  tpOrderId            String?
  lastProtectiveSyncAt DateTime?
  protectiveStatus     String?

  // V5.34: State persistence for stagnant trade detection and trailing stops
  maxPnlPct            Float?        // Max PnL % reached (for stagnant trigger)
  stagnantState        Json?         // {triggered, triggeredAt, confirmed, cancelled, obsPeakPct}
  trailingActive       Boolean       @default(false) // Trailing stop activation status
  highWaterMark        Float?        // Highest price for LONG trailing
  lowWaterMark         Float?        // Lowest price for SHORT trailing
  entryTime            BigInt?       // Unix timestamp (ms) when opened
  marginUsd            Float?        // Margin allocated (USD)

  session              AgentSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([stagnantState])
}

model AgentOpsTelemetry {
  sessionId       String       @id
  tradeCount24h   Int          @default(0)
  lastExecutionAt DateTime?
  blockedByVos    Boolean      @default(false)
  lastBlockedAt   DateTime?
  circuitState    Json?
  adaptiveState   Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  session         AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([blockedByVos, updatedAt])
}

model SessionKpi {
  sessionId        String       @id
  realizedPnlUsd   Float        @default(0)
  unrealizedPnlUsd Float        @default(0)
  roiPct           Float        @default(0)
  winRate          Float        @default(0)
  expectancy       Float        @default(0)
  maxDrawdownPct   Float        @default(0)
  avgHoldingMin    Float        @default(0)
  lastUpdated      DateTime     @default(now())
  stats            Json?
  aiCallsTotal     Int          @default(0)
  aiInputTokens    Int          @default(0)
  aiOutputTokens   Int          @default(0)
  aiCostUsd        Float        @default(0)
  aiByModel        Json?
  session          AgentSession @relation("AgentSessionToSessionKpi", fields: [sessionId], references: [id])
}

model TriggerLog {
  id        String        @id @default(cuid())
  sessionId String?
  symbol    String
  kind      String
  payload   Json
  createdAt DateTime      @default(now())
  session   AgentSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model Alert {
  id        String        @id @default(cuid())
  userId    String?
  sessionId String?
  symbol    String?
  kind      String
  severity  String
  details   Json?
  createdAt DateTime      @default(now())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model DailyReport {
  id        String        @id @default(cuid())
  userId    String?
  sessionId String?
  day       String
  stats     Json?
  llm       Json?
  createdAt DateTime      @default(now())
  session   AgentSession? @relation(fields: [sessionId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@unique([sessionId, day])
  @@index([userId, day])
  @@index([sessionId, day])
}

model ImprovementItem {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  description String
  severity    String   @default("medium")
  status      String   @default("open")
  context     Json?
  tags        String[]
  reporter    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@index([severity])
}

model DiagnosticsCache {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  data      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, createdAt])
  @@index([userId, createdAt])
}

model DecisionMemory {
  id             String   @id @default(cuid())
  sessionId      String?
  symbol         String
  family         String
  timeframe      String   @default("15m")
  bias           String?
  score          Float?
  confidence     Float?
  biasConfidence Float?
  features       Json
  outcome        String?
  realizedPnl    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([symbol, createdAt])
  @@index([family, createdAt])
  @@index([sessionId, createdAt])
}

model AdaptiveThreshold {
  id               String   @id @default(cuid())
  family           String   @unique
  momentumWeight   Float    @default(1)
  volumeWeight     Float    @default(1)
  volatilityWeight Float    @default(1)
  confidence       Float    @default(0)
  sampleSize       Int      @default(0)
  lastWinRate      Float    @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model LeverageConstraint {
  id                 String    @id @default(cuid())
  symbol             String
  category           String?
  targetLeverage     Float?
  hardCap            Float?
  liquidityUsd       Float?
  liquiditySampledAt DateTime?
  atrPct             Float?
  atrSampledAt       DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([symbol, category])
  @@index([symbol])
  @@index([category])
}

model AutoUniverseSchedule {
  id               String    @id @default("auto_universe_retry")
  nextRetryAt      DateTime?
  excludeSessionId String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("auto_universe_schedule")
}

model TradeEvaluation {
  id               String   @id @default(cuid())
  symbol           String
  timestamp        DateTime @default(now())
  decision         String
  blockedReason    String?
  confidenceScore  Float
  inputMetrics     Json
  marketOutcome    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  regimeContext    Json?
  userId           String?
  eligibilityScore Float?
  finalScore       Float?
  strategyFamily   String?
  strategyId       String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, timestamp])
  @@index([symbol, timestamp])
  @@index([timestamp])
  @@index([marketOutcome])
  @@index([strategyFamily, decision])
  @@index([strategyId, decision])
}

model CryptoPersonalityProfile {
  symbol        String   @id
  optimalParams Json
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([updatedAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_setting")
}

model PredictorDecision {
  id               String   @id @default(cuid())
  symbol           String
  decision         String
  previousDecision String?
  probabilityLong  Float
  probabilityShort Float
  confidence       Float
  entryWeight      Float?
  riskMultiplier   Float?
  price            Float
  createdAt        DateTime @default(now())

  @@index([symbol, createdAt])
  @@index([createdAt])
  @@map("predictor_decision")
}

model AgentPerformanceLedger {
  id             String       @id @default(cuid())
  sessionId      String
  agentName      String
  agentFamily    String?
  symbol         String
  mode           String
  regime         String?
  windowMinutes  Int          @default(1440)
  bucketStart    DateTime
  tradeCount     Int          @default(0)
  winRate        Float        @default(0)
  realizedPnlUsd Float        @default(0)
  netPnlUsd      Float        @default(0)
  feesUsd        Float        @default(0)
  avgLatencyMs   Float?
  avgSlippageBps Float?
  avgHoldMinutes Float?
  blockedCount   Int          @default(0)
  complianceHits Int          @default(0)
  score          Float?
  volatilityPct  Float?
  drawdownPct    Float?
  stats          Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, symbol, mode, regime, windowMinutes, bucketStart], name: "agent_performance_window_unique")
  @@index([symbol, mode, bucketStart])
  @@index([sessionId, windowMinutes, bucketStart])
}

model SubagentLearningState {
  id          String   @id @default(cuid())
  subagent    String
  symbol      String
  mode        String?
  regime      String?
  score       Float?
  sampleCount Int      @default(0)
  metrics     Json?
  tuning      Json?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subagent, symbol, mode, regime], name: "subagent_learning_user_unique")
  @@index([userId, symbol, subagent])
  @@index([symbol, subagent])
}

enum AgentActionStatus {
  pending
  in_progress
  completed
  failed
  skipped
}
