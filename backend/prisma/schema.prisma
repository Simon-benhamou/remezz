generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  role         String         @default("trader")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  isLegacy     Boolean        @default(false)
  sessions     AgentSession[]
  reports      DailyReport[]
  apiKeys      UserApiKey[]
  settings     UserSetting[]

  @@index([username])
  @@index([email])
}

model UserApiKey {
  id         String   @id @default(cuid())
  userId     String
  exchange   String
  keyName    String?
  apiKey     String
  apiSecret  String
  passphrase String?
  testnet    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, testnet])
  @@index([userId])
}

model UserSetting {
  id       String @id @default(cuid())
  userId   String
  key      String
  value    String
  category String @default("general")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, category])
}

model AgentSession {
  id                 String              @id @default(cuid())
  userId             String?
  needsAttention     Boolean             @default(false)
  symbol             String
  mode               String
  startedAt          DateTime            @default(now())
  stoppedAt          DateTime?
  haltedAt           DateTime?
  haltReason         String?
  startBalanceUsd    Float?
  profileJson        Json?
  planJson           Json?
  rrFloor            Float               @default(1.0)
  rrCeil             Float               @default(2.0)
  rrBaseMin          Float               @default(1.3)
  rrExpectancy       Json?               @default("{}")
  isSmartAgent       Boolean             @default(false)
  smartConfig        Json?
  currentSymbol      String?
  lastSymbolSwitchAt DateTime?
  nextRescanAt       DateTime?
  smartHistory       Json?
  actionIntents      AgentActionIntent[]
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports            DailyReport[]
  fills              Fill[]
  orders             Order[]
  pendingIntents     PendingIntent[]
  positions          Position[]
  SessionKpi         SessionKpi?         @relation("AgentSessionToSessionKpi")
  trades             Trade[]
  triggers           TriggerLog[]

  @@index([userId, stoppedAt, startedAt])
  @@index([stoppedAt, startedAt])
  @@index([isSmartAgent, nextRescanAt])
}

model AgentActionIntent {
  id            String            @id
  sessionId     String
  symbol        String
  type          String
  priority      String
  confidence    Float
  reason        String
  payload       Json?
  status        AgentActionStatus @default(pending)
  result        Json?
  failureReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  startedAt     DateTime?
  executedAt    DateTime?
  session       AgentSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sessionId, status])
}

model PendingIntent {
  id                String       @id @default(cuid())
  sessionId         String
  symbol            String
  action            String
  targetOffset      Float?
  originalPrice     Float
  originalSignal    Json
  expiresAt         DateTime
  confirmationTicks Int          @default(0)
  status            String       @default("active")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  executedAt        DateTime?
  session           AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, status], name: "one_active_per_session")
  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model Order {
  id                 String        @id @default(cuid())
  clientOrderId      String        @unique
  exchangeOrderId    String?
  sessionId          String?
  symbol             String
  side               String
  type               String
  tif                String?
  qty                Float
  requestedQty       Float?
  price              Float?
  requestedPrice     Float?
  sl                 Float?
  tp                 Float?
  leverage           Float?
  pctChange          Float?
  latencyMs          Int?
  slippageBps        Float?
  fillRatio          Float?
  cancelCount        Int?          @default(0)
  attempts           Int?
  source             String        @default("agent")
  status             String?
  error              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  strategyUsed       String?
  strategyConfidence Float?
  strategyId         String?
  fills              Fill[]
  session            AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
  @@index([strategyUsed, status])
}

model Fill {
  id             String        @id @default(cuid())
  orderId        String
  tradeId        String?
  price          Float
  qty            Float
  fee            Float?
  side           String
  realizedPnl    Float?
  ts             DateTime      @default(now())
  sessionId      String?
  strategyUsed   String?
  symbol         String?
  strategyFamily String?
  strategyId     String?
  entryTs        DateTime?
  exitReason     String?
  maxPnlPct      Float?
  order          Order         @relation(fields: [orderId], references: [id])
  session        AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trade          Trade?        @relation(fields: [tradeId], references: [id])

  @@index([sessionId])
  @@index([orderId])
  @@index([symbol, ts])
  @@index([strategyUsed])
  @@index([strategyFamily, strategyId])
  @@index([tradeId])
}

model Trade {
  id              String       @id @default(cuid())
  sessionId       String
  symbol          String
  positionSide    String
  qty             Float
  entryPrice      Float
  exitPrice       Float
  entryNotional   Float
  realizedPnlUsd  Float
  feesUsd         Float
  pctChange       Float?
  roiPct          Float?
  leverage        Float?
  roePct          Float?
  orderCount      Int          @default(0)
  exitReason      String?
  durationMinutes Int?
  maxPnlPct       Float?
  entryTs         DateTime
  exitTs          DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  fills           Fill[]
  session         AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, exitTs])
  @@index([symbol, exitTs])
  @@index([exitTs])
}

model Position {
  id                    String        @id @default(cuid())
  sessionId             String?
  symbol                String
  side                  String
  entryPrice            Float?
  qty                   Float?
  markPrice             Float?
  unrealizedPnl         Float?
  leverage              Float?
  openedAt              DateTime?     @default(now())
  updatedAt             DateTime      @updatedAt
  stopPrice             Float?
  takeProfit            Json?
  slOrderId             String?
  tpOrderId             String?
  lastProtectiveSyncAt  DateTime?
  protectiveStatus      String?
  entryTime             BigInt?
  highWaterMark         Float?
  lowWaterMark          Float?
  marginUsd             Float?
  maxPnlPct             Float?
  stagnantState         Json?
  trailingActive        Boolean       @default(false)
  trailingBreachCandles Int           @default(0)
  session               AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([stagnantState])
}

model SessionKpi {
  sessionId        String       @id
  realizedPnlUsd   Float        @default(0)
  unrealizedPnlUsd Float        @default(0)
  roiPct           Float        @default(0)
  winRate          Float        @default(0)
  expectancy       Float        @default(0)
  maxDrawdownPct   Float        @default(0)
  avgHoldingMin    Float        @default(0)
  lastUpdated      DateTime     @default(now())
  stats            Json?
  aiCallsTotal     Int          @default(0)
  aiInputTokens    Int          @default(0)
  aiOutputTokens   Int          @default(0)
  aiCostUsd        Float        @default(0)
  aiByModel        Json?
  session          AgentSession @relation("AgentSessionToSessionKpi", fields: [sessionId], references: [id], onDelete: Cascade)
}

model TriggerLog {
  id        String        @id @default(cuid())
  sessionId String?
  symbol    String
  kind      String
  payload   Json
  createdAt DateTime      @default(now())
  session   AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model DailyReport {
  id        String        @id @default(cuid())
  userId    String?
  sessionId String?
  day       String
  stats     Json?
  llm       Json?
  createdAt DateTime      @default(now())
  session   AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])

  @@unique([sessionId, day])
  @@index([userId, day])
  @@index([sessionId, day])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_setting")
}

model TradeParityResult {
  id                 String    @id @default(cuid())
  tradeId            String    @unique
  symbol             String
  side               String
  liveEntryTs        DateTime
  liveExitTs         DateTime
  liveExitReason     String
  livePnlPct         Float
  btEntryTs          DateTime?
  btExitTs           DateTime?
  btExitReason       String?
  btPnlPct           Float?
  entryMatch         Boolean   @default(false)
  exitMatch          Boolean   @default(false)
  pnlMatch           Boolean   @default(false)
  overallMatch       Boolean   @default(false)
  mismatchDetails    String?
  verifiedAt         DateTime  @default(now())
  backtestDurationMs Int?

  @@index([tradeId])
  @@index([verifiedAt])
  @@index([overallMatch])
  @@index([symbol, verifiedAt])
}

enum AgentActionStatus {
  pending
  in_progress
  completed
  failed
  skipped
}
