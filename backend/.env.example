# Trading policy defaults
MIN_TARGET_GAIN_USD=30
RISK_PCT_PER_TRADE=0.015
MIN_RR=2.0

# Execution costs
FEES_BPS=7
SLIP_ALPHA=0.7
SLIP_BETA=0.3
SLIP_CAP_BPS=18

# Execution controls
ENTRY_LIMIT_TIMEOUT_MS=2500
ENTRY_TWAP_TRIGGER_SPREAD_BPS=18
ENTRY_SPLIT_LIMIT=0.6
ENTRY_SPLIT_PA=0.4

# Acceptance policy by regime
ACCEPT_Q_TREND=0.65
ACCEPT_Q_RANGE=0.40
ACCEPT_Q_VOL=0.30

# Strategy regeneration cooldown settings
STRATEGY_MIN_INTERVAL_MIN=60              # Min time between any strategy regenerations
STRATEGY_REGIME_COOLDOWN_MIN=5            # Base cooldown for regime-only shifts
STRATEGY_FORCE_PRICE_PCT=0.25             # Price shift % to force regeneration
STRATEGY_FORCE_REGIME_CONF_DELTA=0.15     # Confidence delta to force regeneration

# Adaptive cooldown improvements
STRATEGY_MIN_CONFIDENCE_DELTA=0.2         # Min confidence change to trigger regime regeneration
STRATEGY_VOLATILITY_ADAPTIVE=true         # Enable volatility-based adaptive cooldown
STRATEGY_USE_COMPOSITE_SCORE=true         # Use composite scoring (price+regime+volatility)
STRATEGY_COMPOSITE_THRESHOLD=0.4          # Composite score threshold for regeneration (0-1)
