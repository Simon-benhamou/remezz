EXCHANGE_ID=binance
SYMBOL=BTCUSDT
MARKET_TYPE=swap

PORT=4000
CORS_ORIGIN=http://localhost:5173

REQUIRE_API_KEY=true
APP_API_KEY=change-me
JWT_SECRET=change-me-jwt

WS_MAX_TIMESTAMP_DRIFT_MS=5000
MARKET_STALE_THRESHOLD_MS=12000
STALE_TICK_SEC=300

MIN_STOP_PCT=0.2
MIN_TP_PCT=0.4
DEFAULT_RISK_PCT=1.5
DEFAULT_MAX_LEVERAGE=10

DATABASE_URL=postgresql://user:password@host:5432/db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini-2025-08-07
OPENAI_COST_IN_PER_1K=0
OPENAI_COST_OUT_PER_1K=0

USE_GROK=false
GROK_API_KEY=
GROK_COST_IN_PER_1K=0
GROK_COST_OUT_PER_1K=0

AUTO_MIN_USD_VOLUME=200000
RANK_ON_START=true

POLL_MS=2000

# Optional monitoring thresholds
ORDER_FILL_TIMEOUT_SEC=10
ORDER_FILL_POLL_MS=250
ORDER_RETRY_MAX=2

# Frontend demo credentials (optional)
AUTH_USER=demo
AUTH_PASS=demo
