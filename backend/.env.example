# Backend environment example — fill with your own values

# Exchange / Symbol
EXCHANGE_ID=cryptocom
SYMBOL=BTCUSDT

# Exchange keys (do not commit real keys)
API_KEY=
API_SECRET=
API_PASSWORD=

# Server
PORT=4000
POLL_MS=5000
CORS_ORIGIN=http://localhost:5173

# Auth and API access
# Set REQUIRE_API_KEY=true in production and provide a strong APP_API_KEY
REQUIRE_API_KEY=false
APP_API_KEY=change-me
AUTH_USER=
AUTH_PASS=
ACCESS_CODE=

# Risk defaults
DEFAULT_RISK_PCT=1.0
DEFAULT_MAX_LEVERAGE=10
DAILY_LOSS_LIMIT_PCT=5
MIN_STOP_PCT=0.2
MIN_TP_PCT=0.4
MIN_FIRST_R=1.5

# LLM providers (optional)
USE_GROK=true
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1/chat/completions
OPENAI_API_KEY=
# OpenAI model (chat.completions)
OPENAI_MODEL=gpt-4o-mini
# Optional cost estimation (USD per 1K tokens)
OPENAI_COST_IN_PER_1K=0.00015
OPENAI_COST_OUT_PER_1K=0.0006
GROK_COST_IN_PER_1K=0.0025
GROK_COST_OUT_PER_1K=0.01

# Database (e.g., Neon Postgres URL with SSL)
DATABASE_URL=

# Engine/analysis throttles
STRATEGY_MIN_INTERVAL_MIN=60
ANALYSIS_TTL_MIN=360
RANK_ON_START=true
MARKET_TYPE=swap
LOG_TRIGGERS=false
TRIGGER_SAMPLE_RATE=0.25
TRIGGER_RETENTION_DAYS=7

# LLM provider routing
USE_GROK_FOR_ANALYSIS=false
USE_GROK_FOR_STRATEGY=false
USE_GROK_FOR_PLAN=false
GROK_ANALYSIS_DAILY_MAX=50
GROK_REVERSAL_PCT_THRESHOLD=3.5

# Breakout invalidation & trailing
# Confirm breakout when price is beyond the entry zone by HYSTERESIS and this holds for CONFIRM_TICKS consecutive ticks
BREAKOUT_HYSTERESIS_PCT=0.15
BREAKOUT_CONFIRM_TICKS=2
# Reverse position automatically on confirmed breakout (use with care)
REVERSE_ON_BREAKOUT=false
# Optional fixed trailing stop in percent (e.g. 0.4 for 0.4%). If 0, fallback to ATR/EMA trailing only.
TRAIL_PCT=0

# Entry filters (optional)
# Avoid weak/oversold shorts: require ADX and RSI minimum
ENTRY_SHORT_MIN_ADX=18
ENTRY_SHORT_MIN_RSI=45
# Avoid weak/overbought longs: require ADX minimum and cap RSI
ENTRY_LONG_MIN_ADX=14
ENTRY_LONG_MAX_RSI=65
