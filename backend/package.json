{
  "name": "trading-agent-ia-backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "tsx watch --inspect=9229 src/server.ts",
    "build": "tsc && node ./scripts/postbuild.mjs",
    "start": "node dist/src/server.js",
    "test:unit": "node ./scripts/run-unit-tests.mjs",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "test:e2e": "node ./scripts/run-e2e-tests.mjs",
    "test": "npm run -s build && npm run -s test:unit && npm run -s test:integration && npm run -s test:e2e",
    "prisma:gen": "prisma generate",
    "db:push": "prisma db push",
    "migrate": "prisma migrate deploy",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "analyze:performance": "tsx scripts/agent-performance-analyzer.ts",
    "analyze:fees": "tsx scripts/analyze-fees.ts",
    "monitor:start": "tsx scripts/agent-performance-monitor.ts start",
    "monitor:once": "tsx scripts/agent-performance-monitor.ts once",
    "monitor:stop": "tsx scripts/agent-performance-monitor.ts stop",
    "monitor:integrated": "tsx scripts/integrated-performance-monitor.ts",
    "train-model": "python3 python/ccxt_xgboost_module.py"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "ccxt": "^4.4.37",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.23.2",
    "ts-node": "^10.9.2",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "prisma": "^5.16.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5"
  }
}
