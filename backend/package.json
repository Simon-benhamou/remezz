{
  "name": "trading-agent-ia-backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "test -f prisma/schema.prisma && prisma generate || true",
    "dev": "LOG_LEVEL=info tsx watch src/server.ts",
    "dev:debug": "LOG_LEVEL=info tsx watch --inspect=9229 src/server.ts",
    "build": "npm run prisma:gen && rm -rf dist && tsc && node ./scripts/postbuild.mjs",
    "start": "node dist/src/server.js",
    "test:unit": "node ./scripts/run-unit-tests.mjs",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "test:e2e": "node ./scripts/run-e2e-tests.mjs",
    "test": "npm run -s build && npm run -s test:unit && npm run -s test:integration && npm run -s test:e2e",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage",
    "test:python": "cd python && pytest",
    "test:python:unit": "cd python && pytest -m unit",
    "test:python:integration": "cd python && pytest -m integration",
    "test:python:coverage": "cd python && pytest --cov=. --cov-report=html --cov-report=term",
    "test:all": "npm run test && npm run test:python",
    "prisma:gen": "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 prisma generate",
    "db:push": "prisma db push",
    "migrate": "prisma migrate deploy",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "analyze:performance": "tsx scripts/agent-performance-analyzer.ts",
    "analyze:fees": "tsx scripts/analyze-fees.ts",
    "analyze:intrabar-gap": "tsx scripts/analyze-intrabar-gap.ts",
    "simulate:trailing-rt": "tsx scripts/simulate-trailing-rt-modes.ts",
    "monitor:start": "tsx scripts/agent-performance-monitor.ts start",
    "monitor:once": "tsx scripts/agent-performance-monitor.ts once",
    "monitor:stop": "tsx scripts/agent-performance-monitor.ts stop",
    "monitor:integrated": "tsx scripts/integrated-performance-monitor.ts",
    "replay:historical": "tsx scripts/run-historical-replay.ts",
    "train-model": "python3 python/ccxt_xgboost_module.py",
    "meta:rejections": "node scripts/meta-adaptive-rejection-summary.mjs",
    "analyze:rejection": "tsx scripts/analyze-order-rejection.ts",
    "test:multi-agent": "tsx scripts/multi-agent-pool-test.ts",
    "init-profiles": "tsx scripts/init-personality-profiles.ts",
    "report:bias": "tsx scripts/bias-statistics-report.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/client": "^6.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "ccxt": "^4.5.26",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.23.2",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.19.24",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5"
  }
}
